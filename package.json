{
  "name": "mandate",
  "version": "0.1.0",
  "description": "Give a shopping agent a signed mandate, not your wallet. Guardrails outside the LLM decide what PayPal may pay.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke:channel3": "tsx scripts/smoke-channel3.ts",
    "smoke:orders": "tsx scripts/smoke-orders.ts",
    "dev": "concurrently -n api,web \"tsx watch src/index.ts\" \"vite web\""
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  }
}
