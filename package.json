{
  "name": "mandate",
  "version": "0.1.0",
  "description": "A shopping agent that can only propose. A person signs the spending contract, and plain code outside the model checks every cart against it. Sandbox only.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke:channel3": "tsx scripts/smoke-channel3.ts",
    "smoke:orders": "tsx scripts/smoke-orders.ts",
    "eval": "tsx scripts/eval.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "eval:datasets": "tsx scripts/export-datasets.ts",
    "eval:mutants": "vitest run test/mutation.test.ts",
    "eval:injection-variants": "tsx scripts/eval-injection-variants.ts",
    "eval:monitors": "tsx scripts/eval-monitors.ts",
    "demo:gif": "tsx scripts/demo-gif.ts",
    "doctor": "tsx scripts/doctor.ts",
    "eval:real": "tsx scripts/eval-real-model.ts",
    "eval:real:report": "tsx scripts/eval-real-report.ts",
    "eval:adaptive": "tsx scripts/eval-adaptive.ts",
    "eval:judge": "tsx scripts/eval-judge.ts",
    "eval:judge:label": "tsx scripts/eval-judge-label.ts",
    "keepalive:report": "tsx scripts/keepalive-report.ts",
    "landing:screenshots": "tsx scripts/landing-screenshots.ts",
    "dev": "concurrently -n api,web \"tsx watch src/index.ts\" \"vite web\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/groq": "^4.0.86",
    "@ai-sdk/openai": "^4.0.121",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "ai": "^7.0.177",
    "dotenv": "^18.0.10",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "author": "Isaac Boqué Carbonell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacboque/mandate.git"
  },
  "homepage": "https://isaacboque.github.io/mandate/",
  "bugs": {
    "url": "https://github.com/isaacboque/mandate/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-safety",
    "guardrails",
    "prompt-injection",
    "evals",
    "typescript",
    "paypal-sandbox"
  ]
}
