# Copy to .env and edit. .env is git-ignored: never commit it. Sandbox only (no real money).
# Check your setup any time with:  npm run doctor      (full reference: docs/CONFIGURATION.md)

# --- Mode ---------------------------------------------------------------------------------------
DEMO_MODE=mock            # mock = simulated payments, no keys needed; live = PayPal sandbox (and the Channel3 catalog)
# CATALOG=fixtures        # fixtures | channel3: where products come from. channel3 outside live mode needs CHANNEL3_API_KEY (else fixtures)
CURRENCY=EUR
PORT=8787

# --- Bring your own model key (optional) --------------------------------------------------------
# Set the key of the provider you use. That is all: the provider is detected from the key.
# Without any key an offline rules agent answers.
GOOGLE_GENERATIVE_AI_API_KEY=   # Google (default model gemini-2.5-flash)
OPENAI_API_KEY=                 # OpenAI (default model gpt-4.1-mini)
ANTHROPIC_API_KEY=              # Anthropic (default model claude-haiku-4-5)
GROQ_API_KEY=                   # Groq, free tier, no card (default model openai/gpt-oss-120b)
# Only if you need them:
# LLM_PROVIDER=groq             # google | openai | anthropic | groq: choose among several keys (otherwise detected, first of the order above)
# LLM_MODEL=                    # override the provider's default model
# OPENAI_BASE_URL=              # any OpenAI-compatible endpoint for the openai provider
# LLM_TIMEOUT_SECONDS=40        # longest wait for one model call
# LLM_MAX_QUEUE=8               # turns allowed to wait for the model; past it a turn gets the "busy" card (0 = nobody waits)
# LLM_DAILY_TURN_BUDGET=150     # model turns per UTC day for the whole server (0 = no limit); protects a free quota

# --- Live mode only (DEMO_MODE=live) ------------------------------------------------------------
# CHANNEL3_MONTHLY_BUDGET=900   # optional soft cap on Channel3 requests per UTC month (free tier: 1000); past it the fixture catalog is used until the 1st
CHANNEL3_API_KEY=               # product catalog, free tier at trychannel3.com
PAYPAL_CLIENT_ID=               # PayPal SANDBOX app (Orders v2)
PAYPAL_CLIENT_SECRET=

# --- Hosting and limits -------------------------------------------------------------------------
TRUSTED_PROXIES=0               # proxies of your own in front of the app (Render: 1); 0 ignores X-Forwarded-For
PUBLIC_SITE_ORIGIN=https://isaacboque.github.io   # the one origin (the static landing page) that may read /api/health from a browser; nothing else is opened to any origin
SESSION_TTL_MINUTES=120         # a visitor's in-memory session is dropped after this long idle
MAX_SESSIONS=300                # most sessions kept at once; the oldest idle one is dropped first
TRACE_RETENTION_HOURS=24        # delete trace files older than this at start-up and hourly (0 keeps them)
# RATE_LIMIT_ASKS_PER_HOUR=12         # defaults: live 12, a model configured 10, else off; searches per visitor per hour (0 = off)
# DAILY_ASK_CAP=300                   # defaults: live 300, a model configured = LLM_DAILY_TURN_BUDGET, else off; searches per day for the whole instance (0 = off)
# RATE_LIMIT_CATEGORIES_PER_HOUR=120  # live-mode default; category look-ups per visitor per hour (0 = off)
