# Copy to .env (never commit .env). Sandbox only.
DEMO_MODE=mock            # mock = fixtures + mock payments, no keys; live = Channel3 + PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CURRENCY=EUR
CHANNEL3_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
TRACE_RETENTION_HOURS=24   # delete trace files older than this at start-up and hourly (0 keeps them)
TRUSTED_PROXIES=0        # how many proxies of your own sit in front of the app (Render: 1). 0 ignores X-Forwarded-For; the per-visitor limit then keys on the socket address
PORT=8787                 # HTTP port
SESSION_TTL_MINUTES=120   # a visitor's in-memory session (contracts, proposals, trace) is dropped after this long idle
MAX_SESSIONS=300          # most sessions kept at once; the oldest idle one is dropped first
# RATE_LIMIT_ASKS_PER_HOUR=12    # live-mode default; searches per visitor per hour (0 = off)
# DAILY_ASK_CAP=300              # live-mode default; searches per day for the whole instance (0 = off)
# RATE_LIMIT_CATEGORIES_PER_HOUR=120  # live-mode default; category look-ups per visitor per hour (0 = off)
